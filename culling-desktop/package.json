{
  "name": "select-ea",
  "productName": "Select EA",
  "description": "Select EA - Intelligent Photo Culling Studio",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder --win dir",
    "electron:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.erickgomx.selectea",
    "productName": "Select EA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ai_worker.exe",
        "to": "ai_worker.exe"
      },
      {
        "from": "models/yunet.onnx",
        "to": "models/yunet.onnx"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Select-EA-Portable.${ext}"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
